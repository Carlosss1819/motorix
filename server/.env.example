# Variables de entorno del backend de Motorix (sin secretos reales)
# Copia este archivo como .env y completa los valores de tu MySQL local.

# conexión a MySQL local (nunca usar root; usuario dedicado motorix_app)
DB_HOST=localhost
DB_PORT=3306
DB_USER=motorix_app
DB_PASSWORD=CAMBIAR_EN_LOCAL
DB_NAME=motorix

# servidor
PORT=3000
NODE_ENV=development

# autenticación (JWT) - valor de desarrollo local, cambiar en cualquier despliegue real
JWT_SECRET=motorix_dev_secret_no_usar_en_produccion

# sesión: duración maxima del token y cierre por inactividad
JWT_EXPIRA_EN=8h
SESSION_IDLE_MS=1800000
