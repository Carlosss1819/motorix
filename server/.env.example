# Variables de entorno del backend de Motorix (sin secretos reales)
# Copia este archivo como .env y completa los valores de tu MySQL local.

# conexión a MySQL local (nunca usar root; usuario dedicado motorix_app)
DB_HOST=localhost
DB_PORT=3306
DB_USER=motorix_app
DB_PASSWORD=CAMBIAR_EN_LOCAL
DB_NAME=motorix_v2

# servidor
PORT=3000
NODE_ENV=development

# autenticación (JWT) - valor de desarrollo local, cambiar en cualquier despliegue real
JWT_SECRET=motorix_dev_secret_no_usar_en_produccion

# sesión: duración maxima del token y cierre por inactividad
JWT_EXPIRA_EN=8h
SESSION_IDLE_MS=1800000

# pasarela de cobro (opcional, Sprint 4): sin MP_ACCESS_TOKEN el backend usa la
# pasarela simulada; nunca subas valores reales al repositorio (RN-14, CA-7)
MP_ACCESS_TOKEN=
MP_PUBLIC_URL=http://localhost:3000

# vigencia de las preferencias nuevas de Mercado Pago en horas (Sprint 5,
# FR-037): entero mayor que 0; si se omite, 24
MP_PREFERENCIA_VIGENCIA_HORAS=24

# avisos internos (Sprint 6, FR-006): días sin cambio de estado para que una
# orden en RECIBIDO, DIAGNOSTICO, EN_REPARACION o ESPERANDO_REFACCION se
# avise como "detenida"; entero mayor que 0; si se omite, 3
NOTIF_ORDEN_DETENIDA_DIAS=3
